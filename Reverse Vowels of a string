class Solution(object):
    def reverseVowels(self, s):
        left=0
        right=len(s)-1
        chars=list(s)
        lst=['a','A','e','E','i','I','o','O','u','U',]
        while left<right:
            if chars[left] not in lst and chars[right] in lst:
                left+=1
            elif chars[right] not in lst and chars[left] in lst:
                right-=1
            elif (chars[left]) and (chars[right]) in lst:
                chars[left],chars[right]=chars[right],chars[left]
                left+=1
                right-=1
            else:
                left+=1
                right-=1
        return "".join(chars)
